EXPO_PUBLIC_CONVEX_URL=https://your-project.convex.cloud
EXPO_PUBLIC_CONVEX_SITE_URL=https://your-project.convex.site
EXPO_PUBLIC_SITE_URL=https://your-app-domain.example
SITE_URL=https://your-app-domain.example

# Privacy-friendly internal analytics. Keep false locally; set true in Cloudflare Production when ready.
EXPO_PUBLIC_ANALYTICS_ENABLED=false

# Current launch sign-in uses email/password plus a local profile fallback.
# Social sign-in can be revisited later when OAuth/app-store setup is ready.

# Optional admin email notifications through Resend:
# npx convex env set RESEND_API_KEY re_your_resend_key --prod
# npx convex env set ADMIN_NOTIFICATION_FROM "Bible Study Tutor <notifications@biblestudytutor.org>" --prod

# Backend-only configuration (set on the reviewed Convex target, never EXPO_PUBLIC):
# ADMIN_USER_IDS: comma-separated approved auth user IDs. ADMIN_EMAILS only routes notifications.
# AUTH_EMAIL_FROM: verified Resend sender for password reset messages.
# RESEND_API_KEY: secret Resend API key. Email reset UI remains unavailable without both email settings.
